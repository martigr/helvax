# Copy to .env and fill in. Never commit .env; keep it private: chmod 600 .env
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
ADMIN_USERNAME=admin
# At least 10 characters; only used to create the first admin on an empty database
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=1
# Number of reverse proxies in front of the app (1 for Nginx Proxy Manager/Caddy/Traefik on this host)
TRUSTED_PROXIES=1
# Who to contact about security problems of this instance (shown in /.well-known/security.txt)
SECURITY_CONTACT=mailto:admin@example.org
# Who runs this instance and how to reach them (shown on the privacy page /privacy)
PRIVACY_CONTROLLER=Familie Muster
PRIVACY_CONTACT=admin@example.org

# Public address of the app, used for links in mails and push messages
BASE_URL=https://helvax.example.org

# Mail (optional; without it there are no reminders and no "Passwort vergessen?").
# Port 587 with STARTTLS; for port 465: SMTP_PORT=465, SMTP_SECURITY=ssl
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=helvax@example.org
SMTP_PASSWORD=
MAIL_FROM=helvax@example.org
MAIL_FROM_NAME=helvax

# Push messages (optional; needs HTTPS): create the key once with
#   docker compose run --rm web flask --app helvax gen-vapid-key
# and keep it; a new key ends all push subscriptions. Push is off while it is empty.
VAPID_PRIVATE_KEY=
# Contact for the push services; default mailto:MAIL_FROM
#VAPID_SUBJECT=mailto:admin@example.org
